# Copy this file to .env and adjust. .env is git-ignored.

SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:4200

# Tax reserve estimate in percent (finance_app default on first access)
TAX_RESERVE_RATE=25

# Absolute path for all user data (SQLite DB + uploaded media).
# Leave unset in dev (defaults to backend/data). The desktop build sets this
# to the folder the user picks on first start.
# DATA_DIR=/absolute/path/to/data

# Optional PostgreSQL (leave DB_ENGINE unset to use SQLite)
# DB_ENGINE=postgres
# DB_NAME=ebaytool
# DB_USER=ebaytool
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# eBay API – developer.ebay.com → Application Keysets
# EBAY_ENV: sandbox | production (use the matching keyset)
EBAY_ENV=sandbox
EBAY_CLIENT_ID=your-app-id
EBAY_CLIENT_SECRET=your-cert-id
EBAY_RUNAME=your-runame
EBAY_MARKETPLACE_ID=EBAY_DE
# Encrypts the stored eBay tokens. Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EBAY_TOKEN_KEY=your-fernet-key
