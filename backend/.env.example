# Copy this file to .env and adjust. .env is git-ignored.

SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Tax reserve estimate in percent (finance_app default on first access)
TAX_RESERVE_RATE=25

# Optional PostgreSQL (leave DB_ENGINE unset to use SQLite)
# DB_ENGINE=postgres
# DB_NAME=ebaytool
# DB_USER=ebaytool
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
